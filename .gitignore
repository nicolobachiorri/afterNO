# What git must NOT track in this project.
# A line is a pattern; a folder pattern also excludes everything inside it.

# Python virtual environments: rebuilt from requirements.txt, never shared
.venv/

# Screenshots of the divergence test: large, regenerable. The JSON files in raw/ stay,
# because they are the raw data behind the step 1 results.
divergence_work_space/raw/*.png

# Temporary and personal files
_to_delete/
__pycache__/
.DS_Store
*.pdf

# extension/ has its own .gitignore (node_modules, .output, .wxt), which git applies too

# Tranco list: large and downloadable again from its permanent ID (see quality/sites.csv)
quality/top-1m.csv
quality/*.zip

# Quality measurement: screenshots stay local (large); results and raw data are kept
quality/runs/**/*.png

# R session history
.Rhistory

# Store screenshots: the raw captures show the sites' names; only the composed
# panels (names hidden) are tracked
store/screenshots/*/raw/

# Working notes, not published
Spec MVP.md
